# Copiar a .env (nunca commitear ese archivo) y generar valores propios:
#   openssl rand -base64 24 | tr -d '/+='   # PG_PASS, NEXTCLOUD_ADMIN_PASSWORD, NEXTCLOUD_SERVICE_PASSWORD
#   openssl rand -base64 32                 # WEBHOOK_ADAPTER_SECRET
# NEXTCLOUD_SERVICE_PASSWORD la vuelve a pedir occ user:add al crear el usuario "audit-core" — usar el mismo valor.

PG_PASS=
NEXTCLOUD_ADMIN_PASSWORD=
NEXTCLOUD_SERVICE_PASSWORD=
# Header estático que Nextcloud manda en cada llamada al adaptador (X-Adapter-Secret) — es lo único que soporta
# authMethod=header de la app nativa `webhook_listeners`, no una firma calculada por request.
WEBHOOK_ADAPTER_SECRET=
