# Copiar a .env (nunca commitear ese archivo) y generar valores propios:
#   openssl rand -base64 36   # PG_PASS, AUTHENTIK_SECRET_KEY
# El resto de las claves (AUTHENTIK_BOOTSTRAP_TOKEN, OIDC_CLIENT_SECRET) las genera Authentik/el script de
# aprovisionamiento — ver ../README.md.

PG_PASS=
# Clave interna de Authentik (firma de sesiones, etc.), no un secreto de OIDC.
AUTHENTIK_SECRET_KEY=

# Cuenta admin que Authentik crea sola al arrancar por primera vez (akadmin es aparte, lo pide el propio setup wizard).
AUTHENTIK_BOOTSTRAP_EMAIL=admin@local.test
AUTHENTIK_BOOTSTRAP_PASSWORD=
# Token de API con el que register-oidc-providers.sh crea los providers/aplicaciones (Admin interface ->
# Directory -> Tokens, o se genera solo si se define ESTA variable antes del primer arranque).
AUTHENTIK_BOOTSTRAP_TOKEN=

# Client id/secret del provider OIDC "audit-core" (register-oidc-providers.sh los genera si no existen; copiarlos
# después a audit-core/.env como AUTHENTIK_CLIENT_ID / lo que corresponda).
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Password compartida de los usuarios de prueba (gerente1, auditor1, auditor2) que ya trae el seed de audit-core.
TEST_USERS_PASSWORD=Prueba123!
