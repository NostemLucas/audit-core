{
  "name": "audit-core",
  "version": "0.0.0",
  "private": true,
  "description": "Backend de auditorías de seguridad y cumplimiento",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.3",
    "@nestjs/testing": "^12.0.3",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/express": "^5.0.6",
    "@types/node": "24.13.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "prisma": "7.10.0",
    "supertest": "^7.2.2",
    "testcontainers": "^12.1.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@nestjs-cls/transactional": "^3.3.0",
    "@nestjs-cls/transactional-adapter-prisma": "^1.4.0",
    "@nestjs/common": "^12.0.3",
    "@nestjs/core": "^12.0.3",
    "@nestjs/platform-express": "^12.0.3",
    "@nestjs/swagger": "^12.0.1",
    "@nestjs/throttler": "^6.7.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "7.10.0",
    "helmet": "^8.3.0",
    "nestjs-cls": "^6.3.0",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "type": "module",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "test:all": "vitest run && vitest run -c vitest.integration.config.ts",
    "postinstall": "prisma generate",
    "pretypecheck": "prisma generate",
    "pretest": "prisma generate",
    "pretest:integration": "prisma generate",
    "pretest:all": "prisma generate",
    "prebuild": "prisma generate"
  }
}
