{
  "name": "audit-core",
  "version": "0.0.0",
  "private": true,
  "description": "Backend de auditorías de seguridad y cumplimiento",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@nestjs/cli": "^12.0.3",
    "@nestjs/testing": "^12.0.3",
    "@standard-schema/spec": "1.1.0",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/express": "^5.0.6",
    "@types/node": "24.13.6",
    "@types/supertest": "^7.2.1",
    "dependency-cruiser": "18.4.0",
    "eslint": "10.11.0",
    "husky": "9.1.7",
    "knip": "6.37.0",
    "pino-pretty": "^13.1.3",
    "prettier": "3.9.8",
    "prisma": "7.10.0",
    "supertest": "^7.2.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@casl/ability": "^7.0.1",
    "@nestjs-cls/transactional": "^3.3.0",
    "@nestjs-cls/transactional-adapter-prisma": "^1.4.0",
    "@nestjs/common": "^12.0.3",
    "@nestjs/core": "^12.0.3",
    "@nestjs/platform-express": "^12.0.3",
    "@nestjs/swagger": "^12.0.1",
    "@nestjs/throttler": "^6.7.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "7.10.0",
    "docxtemplater": "3.71.0",
    "exceljs": "4.4.0",
    "helmet": "^8.3.0",
    "jose": "^6.2.12",
    "nestjs-cls": "^6.3.0",
    "pino": "^10.3.1",
    "pizzip": "3.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "type": "module",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "preseed": "tsc -p tsconfig.seed.json",
    "seed": "node dist-seed/prisma/seeds/seed.js",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "test:all": "vitest run && vitest run -c vitest.integration.config.ts",
    "postinstall": "prisma generate",
    "pretypecheck": "prisma generate",
    "pretest": "prisma generate",
    "pretest:integration": "prisma generate",
    "pretest:all": "prisma generate",
    "prebuild": "prisma generate",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deps": "depcruise src --config .dependency-cruiser.cjs",
    "knip": "knip",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run deps && npm run knip && npm test",
    "check:all": "npm run check && npm run test:integration",
    "prepare": "husky"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
