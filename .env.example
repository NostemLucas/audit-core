# Credenciales del Postgres de `docker-compose.yml` (servicio `postgres`). DATABASE_URL usa `localhost`: es lo que
# necesita `npm run dev` corriendo en el host contra el puerto publicado. Los servicios `migrate`/`app` del compose
# (perfil `prod`) arman su PROPIO DATABASE_URL con estas mismas credenciales apuntando a `postgres` (el nombre del
# servicio), no a este valor — no hace falta un segundo archivo de entorno.
POSTGRES_USER=audit
POSTGRES_PASSWORD=audit
POSTGRES_DB=audit_core
DATABASE_URL=postgresql://audit:audit@localhost:5432/audit_core

PORT=3000
AUTHENTIK_ISSUER=https://auth.ejemplo.com/application/o/audit/
AUTHENTIK_CLIENT_ID=cambia-esto
# AUTHENTIK_JWKS_URI=   # por defecto: <AUTHENTIK_ISSUER>jwks/
CORS_ORIGINS=http://localhost:5173
NEXTCLOUD_BASE_URL=https://nextcloud.ejemplo.com
NEXTCLOUD_SERVICE_USER=audit-core
NEXTCLOUD_SERVICE_PASSWORD=cambia-esto
NEXTCLOUD_WEBHOOK_SECRET=cambia-esto
# LOG_LEVEL=debug   # fatal|error|warn|info|debug|trace|silent (por defecto: info; silent en test)
# LOG_PRETTY=true   # consola legible; por defecto solo en desarrollo
