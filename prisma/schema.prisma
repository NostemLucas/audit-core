// Fuente única de: tablas, columnas, relaciones y enums.  Ver docs/01-domain-model.md y docs/02-architecture.md
//
// Convenciones
//  - Texto libre = `String` (text en Postgres). Las longitudes máximas viven SOLO en src/shared/limits.ts (Zod).
//  - Instantes = Timestamptz(3). Fechas de calendario (plazos) = Date.
//  - Puntajes, pesos y valores de nivel = Decimal(5,2). Se convierten a `number` en los mappers, nunca en el dominio.
//  - Sellos `createdById` / `updatedById`: ids planos (sin FK) rellenados por una Prisma client extension.
//    El nombre se hidrata con UserDirectory. Solo las raíces de agregado los llevan.
//  - Sin soft-delete genérico. Único `deletedAt`: Evidence.
//  - Lo que Prisma no puede declarar (CHECK, secuencia del código de auditoría) está en el bloque
//    "Objetos que Prisma no modela" al final de prisma/migrations/*_init/migration.sql.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums  (se reexportan desde src/shared/enums.ts; nadie más importa el cliente generado)
// ─────────────────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  GERENTE
  AUDITOR
}

enum AssetType {
  APPLICATION
  SYSTEM
  INFRASTRUCTURE
  PROCESS
  FACILITY
  DEPARTMENT
  OTHER
}

/// Solo afecta al widget del frontend; el cálculo es uniforme para todos los tipos.
enum ScaleType {
  RANGE
  BINARY
  QUALITATIVE
}

enum TemplateStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AuditStatus {
  DRAFT
  IN_PROGRESS
  CLOSED
  ARCHIVED
}

enum ScopeMode {
  FULL_ORGANIZATION
  SELECTED_ASSETS
}

enum AuditRole {
  LEAD_AUDITOR
  INSPECTOR
}

enum EvaluationStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  RETURNED
  APPROVED
}

enum ReviewAction {
  APPROVE
  RETURN
  REASSIGN
  REOPEN
  RESTORE
}

enum ReportType {
  COMPLIANCE
  EXECUTIVE_SUMMARY
  FINDINGS
  GAP_ANALYSIS
  OTHER
}

// ─────────────────────────────────────────────────────────────────────────────
// Identidad y auditados
// ─────────────────────────────────────────────────────────────────────────────

/// Se crea/actualiza solo por sincronización con Authentik en cada login. Nunca se borra (el resto del sistema
/// lo referencia). NO tiene estado de activación: si una persona puede entrar o no lo decide Authentik.
/// `email` y `username` se normalizan a minúsculas en la aplicación antes de guardar.
model User {
  id          String  @id @default(uuid(7)) @db.Uuid
  authentikId String  @unique
  email       String  @unique
  username    String  @unique
  names       String
  lastNames   String
  /// Dato local (no sincronizado)
  ci          String?
  /// Dato local (no sincronizado)
  phone       String?
  roles       Role[]

  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  createdById String?  @db.Uuid
  updatedById String?  @db.Uuid

  managedAudits       Audit[]            @relation("AuditManager")
  memberships         AuditMember[]
  assignedEvaluations Evaluation[]
  reviewsDone         EvaluationReview[]
  eventsActed         AuditEvent[]       @relation("EventActor")
  eventsTargeted      AuditEvent[]       @relation("EventTarget")

  @@map("users")
}

/// A quién auditamos (no es un tenant). No se borra si tiene auditorías (FK Restrict): se desactiva.
model Organization {
  id          String  @id @default(uuid(7)) @db.Uuid
  name        String  @unique
  description String?
  address     String?
  phone       String?
  email       String?
  isActive    Boolean @default(true)

  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  createdById String?  @db.Uuid
  updatedById String?  @db.Uuid

  assets Asset[]
  audits Audit[]

  @@map("organizations")
}

/// Cosa auditable dentro de una organización (sistema, proceso, sede…). Catálogo reutilizable entre auditorías.
model Asset {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @db.Uuid
  name           String
  type           AssetType @default(OTHER)
  description    String?
  isActive       Boolean   @default(true)

  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  createdById String?  @db.Uuid
  updatedById String?  @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  auditLinks   AuditAsset[]

  @@unique([organizationId, name])
  // Destino de la FK compuesta de AuditAsset: garantiza que el activo pertenece a la organización auditada.
  @@unique([id, organizationId])
  @@map("assets")
}

// ─────────────────────────────────────────────────────────────────────────────
// Biblioteca
// ─────────────────────────────────────────────────────────────────────────────

/// Escala de valoración (COBIT 5, CMMI, binaria, cualitativa…).
model Scale {
  id          String    @id @default(uuid(7)) @db.Uuid
  code        String    @unique
  name        String    @unique
  type        ScaleType @default(RANGE)
  description String?
  isActive    Boolean   @default(true)

  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  createdById String?  @db.Uuid
  updatedById String?  @db.Uuid

  levels ScaleLevel[]
  audits Audit[]

  @@map("scales")
}

model ScaleLevel {
  id          String  @id @default(uuid(7)) @db.Uuid
  scaleId     String  @db.Uuid
  value       Decimal @db.Decimal(5, 2)
  label       String
  shortName   String?
  description String
  /// Color hex `#RRGGBB`
  color       String
  position    Int

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  scale             Scale              @relation(fields: [scaleId], references: [id], onDelete: Cascade)
  suggestedFindings SuggestedFinding[]
  expectedIn        Evaluation[]       @relation("EvaluationExpectedLevel")
  achievedIn        Evaluation[]       @relation("EvaluationAchievedLevel")

  @@unique([scaleId, value])
  @@map("scale_levels")
}

/// Una norma completa e identificada por su nombre (p. ej. "ISO/IEC 27001:2022").
/// PUBLISHED es inmutable: corregir = clonar con otro nombre.
model Template {
  id          String         @id @default(uuid(7)) @db.Uuid
  name        String         @unique
  description String?
  status      TemplateStatus @default(DRAFT)

  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  createdById String?  @db.Uuid
  updatedById String?  @db.Uuid

  controls Control[]
  audits   Audit[]

  @@map("templates")
}

/// Nodo del árbol de la plantilla. Evaluable = hoja (sin hijos). Los capítulos de primer nivel tienen parentId NULL.
/// Se carga completo por plantilla y el árbol se arma en memoria.
model Control {
  id          String  @id @default(uuid(7)) @db.Uuid
  templateId  String  @db.Uuid
  parentId    String? @db.Uuid
  /// Numeración de la norma, p. ej. "A.5.1"
  code        String
  title       String
  description String?
  /// Guía para el auditor. Única guía del sistema (no hay override por auditoría).
  guidance    String?
  position    Int

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  template          Template           @relation(fields: [templateId], references: [id], onDelete: Cascade)
  parent            Control?           @relation("ControlTree", fields: [parentId, templateId], references: [id, templateId], onDelete: Cascade)
  children          Control[]          @relation("ControlTree")
  suggestedFindings SuggestedFinding[]
  evaluations       Evaluation[]

  @@unique([templateId, code])
  // Destino de la FK compuesta del árbol: el padre debe ser de la misma plantilla.
  @@unique([id, templateId])
  @@index([templateId, parentId, position])
  @@index([parentId])
  @@map("controls")
}

/// Hallazgo redactado de antemano para (control, nivel). Se copia a Evaluation.findings solo si está vacío.
/// Solo existen filas con texto real; la matriz completa se calcula al leer.
model SuggestedFinding {
  id        String @id @default(uuid(7)) @db.Uuid
  controlId String @db.Uuid
  levelId   String @db.Uuid
  text      String

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  control Control    @relation(fields: [controlId], references: [id], onDelete: Cascade)
  level   ScaleLevel @relation(fields: [levelId], references: [id], onDelete: Cascade)

  @@unique([controlId, levelId])
  @@index([levelId])
  @@map("suggested_findings")
}

// ─────────────────────────────────────────────────────────────────────────────
// Auditorías
// ─────────────────────────────────────────────────────────────────────────────

model Audit {
  id   String @id @default(uuid(7)) @db.Uuid
  /// Generado desde la secuencia `audit_code_seq` (ver migración inicial)
  code String @unique
  name String

  /// HTML permitido (se sanea en la entrada)
  introduction String?
  scopeNotes   String?
  objectives   String?

  templateId     String @db.Uuid
  organizationId String @db.Uuid
  scaleId        String @db.Uuid
  managerId      String @db.Uuid

  /// Seguimiento: auditoría cerrada a la que esta da continuidad
  parentAuditId  String? @db.Uuid
  /// 0 = auditoría inicial
  followUpNumber Int     @default(0)

  status    AuditStatus @default(DRAFT)
  scopeMode ScopeMode   @default(FULL_ORGANIZATION)

  plannedStart DateTime? @db.Date
  plannedEnd   DateTime? @db.Date
  startedAt    DateTime? @db.Timestamptz(3)
  closedAt     DateTime? @db.Timestamptz(3)
  /// Snapshot congelado al cerrar. En curso se calcula con scoring.ts
  finalScore   Decimal?  @db.Decimal(5, 2)

  /// Id de la carpeta en Nextcloud. La ruta se deriva de `code` (storage-paths.ts)
  storageFolderId String?

  /// Bloqueo optimista (se incrementa en cada update desde el adaptador)
  version Int @default(0)

  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  createdById String?  @db.Uuid
  updatedById String?  @db.Uuid

  template     Template     @relation(fields: [templateId], references: [id], onDelete: Restrict)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  scale        Scale        @relation(fields: [scaleId], references: [id], onDelete: Restrict)
  manager      User         @relation("AuditManager", fields: [managerId], references: [id], onDelete: Restrict)
  parentAudit  Audit?       @relation("AuditFollowUp", fields: [parentAuditId], references: [id], onDelete: Restrict)
  followUps    Audit[]      @relation("AuditFollowUp")

  assets      AuditAsset[]
  members     AuditMember[]
  evaluations Evaluation[]
  reports     Report[]
  events      AuditEvent[]

  @@unique([parentAuditId, followUpNumber])
  // Destino de la FK compuesta de AuditAsset
  @@unique([id, organizationId])
  @@index([organizationId, status])
  @@index([templateId])
  @@index([managerId])
  @@index([status, plannedEnd])
  @@map("audits")
}

/// Activos dentro del alcance (solo si Audit.scopeMode = SELECTED_ASSETS; regla de dominio: al menos uno).
/// Las dos FK compuestas comparten `organizationId`: la BD garantiza que el activo es de la organización auditada.
model AuditAsset {
  auditId        String @db.Uuid
  assetId        String @db.Uuid
  organizationId String @db.Uuid

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  audit Audit @relation(fields: [auditId, organizationId], references: [id, organizationId], onDelete: Cascade)
  asset Asset @relation(fields: [assetId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@id([auditId, assetId])
  @@index([assetId])
  @@map("audit_assets")
}

/// Quitar un miembro es un borrado; queda registrado en AuditEvent.
model AuditMember {
  id      String    @id @default(uuid(7)) @db.Uuid
  auditId String    @db.Uuid
  userId  String    @db.Uuid
  role    AuditRole @default(INSPECTOR)
  notes   String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  audit Audit @relation(fields: [auditId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([auditId, userId])
  @@index([userId])
  @@map("audit_members")
}

/// Evaluación de un control (hoja) dentro de una auditoría. El estado vigente vive aquí;
/// el historial de decisiones está en EvaluationReview. (Antes: audit_responses + audit_evaluations.)
model Evaluation {
  id        String @id @default(uuid(7)) @db.Uuid
  auditId   String @db.Uuid
  controlId String @db.Uuid

  /// Suma de pesos por auditoría = 100 (regla de dominio)
  weight          Decimal @default(0) @db.Decimal(5, 2)
  /// Nivel objetivo. Nulo = máximo de la escala de la auditoría
  expectedLevelId String? @db.Uuid
  assignedUserId  String? @db.Uuid

  status EvaluationStatus @default(NOT_STARTED)
  /// Ronda devolver/corregir, desde 1
  round  Int              @default(1)

  achievedLevelId String?  @db.Uuid
  /// achieved.value / expected.value × 100, tope 100. Calculado por scoring.ts en cada cambio
  score           Decimal? @db.Decimal(5, 2)
  findings        String?
  notes           String?

  isNotApplicable     Boolean @default(false)
  notApplicableReason String?

  /// Bloqueo optimista
  version Int @default(0)

  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  createdById String?  @db.Uuid
  updatedById String?  @db.Uuid

  audit         Audit       @relation(fields: [auditId], references: [id], onDelete: Cascade)
  control       Control     @relation(fields: [controlId], references: [id], onDelete: Restrict)
  expectedLevel ScaleLevel? @relation("EvaluationExpectedLevel", fields: [expectedLevelId], references: [id], onDelete: Restrict)
  achievedLevel ScaleLevel? @relation("EvaluationAchievedLevel", fields: [achievedLevelId], references: [id], onDelete: Restrict)
  assignedUser  User?       @relation(fields: [assignedUserId], references: [id], onDelete: SetNull)

  reviews   EvaluationReview[]
  evidences Evidence[]

  @@unique([auditId, controlId])
  @@index([auditId, status])
  @@index([assignedUserId, status])
  @@index([controlId])
  @@map("evaluations")
}

/// Log append-only de decisiones sobre una evaluación. `snapshot` guarda el contenido en ese momento
/// (nivel, score, hallazgos, notas, N/A, ids de evidencia; tipado con Zod). Restaurar una ronda lee el snapshot.
model EvaluationReview {
  id           String       @id @default(uuid(7)) @db.Uuid
  evaluationId String       @db.Uuid
  round        Int
  action       ReviewAction
  actorId      String       @db.Uuid
  comments     String?
  snapshot     Json

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  evaluation Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  actor      User       @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([evaluationId, createdAt])
  @@index([actorId, createdAt])
  @@map("evaluation_reviews")
}

/// Metadatos de un archivo de evidencia. La fuente de verdad del archivo es Nextcloud (`storageFileId`).
/// Quién la subió = `createdById`. Único modelo con soft-delete: la evidencia eliminada debe seguir siendo trazable.
model Evidence {
  id            String    @id @default(uuid(7)) @db.Uuid
  evaluationId  String    @db.Uuid
  /// Ronda de la evaluación en la que se adjuntó
  round         Int
  title         String
  description   String?
  fileName      String
  mimeType      String
  size          BigInt
  storageFileId String    @unique
  deletedAt     DateTime? @db.Timestamptz(3)

  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  createdById String?  @db.Uuid
  updatedById String?  @db.Uuid

  evaluation Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)

  @@index([evaluationId, round])
  @@map("evidences")
}

/// Informe generado. Solo se guarda si la generación tuvo éxito. Quién lo generó = `createdById`.
model Report {
  id            String     @id @default(uuid(7)) @db.Uuid
  auditId       String     @db.Uuid
  type          ReportType @default(COMPLIANCE)
  title         String
  storageFileId String     @unique
  fileName      String
  size          BigInt

  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  createdById String?  @db.Uuid
  updatedById String?  @db.Uuid

  audit Audit @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@index([auditId, createdAt])
  @@map("reports")
}

// ─────────────────────────────────────────────────────────────────────────────
// Historial
// ─────────────────────────────────────────────────────────────────────────────

/// Log append-only de cada auditoría. Sin texto: `type` + `payload` (Zod discriminado por `type`, en events.ts
/// de cada módulo). El mensaje se genera al leer (messages.es.ts). `type` y `subjectType` son String a propósito:
/// agregar un evento no debe requerir una migración.
model AuditEvent {
  id           String  @id @default(uuid(7)) @db.Uuid
  auditId      String  @db.Uuid
  type         String
  actorId      String? @db.Uuid
  targetUserId String? @db.Uuid
  subjectType  String
  subjectId    String  @db.Uuid
  payload      Json

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  audit      Audit @relation(fields: [auditId], references: [id], onDelete: Cascade)
  actor      User? @relation("EventActor", fields: [actorId], references: [id], onDelete: Restrict)
  targetUser User? @relation("EventTarget", fields: [targetUserId], references: [id], onDelete: Restrict)

  @@index([auditId, createdAt])
  @@index([subjectType, subjectId])
  @@index([actorId])
  @@index([targetUserId])
  @@map("audit_events")
}
