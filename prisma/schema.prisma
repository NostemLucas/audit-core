// Fuente única de: tablas, columnas, relaciones y enums.  Ver docs/01-domain-model.md y docs/02-architecture.md
//
// Convenciones
//  - Texto libre = `String` (text en Postgres). Las longitudes máximas viven SOLO en src/shared/limits.ts (Zod).
//  - Instantes = Timestamptz(3). Fechas de calendario (plazos) = Date.
//  - Puntajes de las opciones de una escala = Decimal(5,2). Se convierten a `number` en los mappers, nunca en el dominio.
//  - Sellos `createdById` / `updatedById`: ids planos (sin FK) rellenados por una Prisma client extension.
//    El nombre se hidrata con UserDirectory. Solo las raíces de agregado los llevan (no `User`).
//  - Sin soft-delete genérico. Único `deletedAt`: Evidence.
//  - Lo que Prisma no puede declarar (CHECK, secuencia del código de auditoría) está en el bloque
//    "Objetos que Prisma no modela" al final de prisma/migrations/*_init/migration.sql.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums  (se reexportan desde src/shared/enums.ts; nadie más importa el cliente generado)
// ─────────────────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  GERENTE
  AUDITOR
}

/// Qué mide una escala. No cambia el cálculo: solo cómo se etiqueta y presenta el resultado y qué nivel esperado se
/// sugiere (docs/05 §11).
enum ScaleDimension {
  CONFORMITY
  MATURITY
}

enum TemplateStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AuditStatus {
  DRAFT
  IN_PROGRESS
  CLOSED
  ARCHIVED
}

enum AuditRole {
  LEAD_AUDITOR
  INSPECTOR
}

enum EvaluationStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  RETURNED
  APPROVED
}

enum ReviewAction {
  APPROVE
  RETURN
  REASSIGN
  REOPEN
  RESTORE
}

enum ReportType {
  COMPLIANCE
  EXECUTIVE_SUMMARY
  FINDINGS
  GAP_ANALYSIS
  OTHER
}

// ─────────────────────────────────────────────────────────────────────────────
// Identidad y auditados
// ─────────────────────────────────────────────────────────────────────────────

/// Espejo mínimo de la cuenta en Authentik: solo lo que el sistema usa. Se crea/actualiza únicamente por la
/// sincronización en cada login. Nunca se borra (el resto del sistema lo referencia). NO tiene estado de
/// activación (lo decide Authentik) ni sellos de auditoría (nadie "crea" a un usuario: lo crea su propio login).
model User {
  id          String @id @default(uuid(7)) @db.Uuid
  /// Claim `sub`. Inmutable.
  authentikId String @unique
  /// Claim `email`. Se normaliza a minúsculas (lo garantiza un CHECK).
  email       String @unique
  /// Claim `preferred_username`, TAL CUAL (sin normalizar): es el usuario de Nextcloud al compartir carpetas.
  username    String @unique
  /// Claim `name` (nombre completo). Authentik no entrega apellidos por separado de forma fiable.
  name        String
  /// Sincronizado desde los grupos de Authentik; no es editable localmente.
  roles       Role[]

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  managedAudits       Audit[]            @relation("AuditManager")
  memberships         AuditMember[]
  assignedEvaluations Evaluation[]
  reviewsDone         EvaluationReview[]
  eventsActed         AuditEvent[]       @relation("EventActor")
  eventsTargeted      AuditEvent[]       @relation("EventTarget")

  @@map("users")
}

/// A quién auditamos (no es un tenant): la referencia del auditado, para agrupar auditorías y activos.
/// Solo el nombre y si se puede elegir para auditorías nuevas. El sistema es de auditorías: no gestiona datos de
/// organizaciones (dirección, contactos, descripción…). Si eso se necesita, lo gestionará otro sistema y aquí se
/// enlazará con un identificador externo (columna nueva, migración aditiva). No se borra si tiene auditorías
/// (FK Restrict): se desactiva.
model Organization {
  id       String  @id @default(uuid(7)) @db.Uuid
  name     String  @unique
  isActive Boolean @default(true)

  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  createdById String?  @db.Uuid
  updatedById String?  @db.Uuid

  audits Audit[]

  @@map("organizations")
}

// ─────────────────────────────────────────────────────────────────────────────
// Biblioteca
// ─────────────────────────────────────────────────────────────────────────────

/// Escala de valoración: es donde vive el concepto de "cómo se puntúa" (docs/05 §11). Una lista ordenada de opciones,
/// cada una con su etiqueta y su puntaje (p. ej. "ISO 27001 – Conformidad": Cumple 100 · Parcial 50 · No cumple 0;
/// o "Madurez 0–5"). La plantilla no conoce puntajes: la auditoría elige plantilla y escala. `dimension` dice qué mide.
/// Sin `type`: "binaria" es simplemente tener 2 opciones. Sin `code`: `name` la identifica (igual que Template).
/// Invariantes (dominio, ver docs/01): al menos 2 opciones, puntajes únicos, etiquetas únicas sin distinguir
/// mayúsculas, y el puntaje máximo > 0. El puntaje de una opción no se edita una vez usada en una auditoría.
model Scale {
  id        String         @id @default(uuid(7)) @db.Uuid
  name      String         @unique
  dimension ScaleDimension
  isActive  Boolean        @default(true)

  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  createdById String?  @db.Uuid
  updatedById String?  @db.Uuid

  levels ScaleLevel[]
  audits Audit[]

  @@map("scales")
}

/// Opción de una escala. `value` es su PUNTAJE (convención de la función de auditoría: ni un nivel medido ni un peso).
/// El orden es el del `value` (no hay `position`). Sin `color` ni `shortName`: son cosa de presentación y el frontend
/// los deriva del valor normalizado. Los informes usan `label`, `value` y `description`.
model ScaleLevel {
  id          String  @id @default(uuid(7)) @db.Uuid
  scaleId     String  @db.Uuid
  value       Decimal @db.Decimal(5, 2)
  label       String
  description String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  scale             Scale              @relation(fields: [scaleId], references: [id], onDelete: Cascade)
  suggestedFindings SuggestedFinding[]
  expectedIn        Evaluation[]       @relation("EvaluationExpectedLevel")
  achievedIn        Evaluation[]       @relation("EvaluationAchievedLevel")

  @@unique([scaleId, value])
  @@map("scale_levels")
}

/// Una norma completa e identificada por su nombre (p. ej. "ISO/IEC 27001:2022").
/// PUBLISHED es inmutable: corregir = clonar con otro nombre.
model Template {
  id     String         @id @default(uuid(7)) @db.Uuid
  name   String         @unique
  status TemplateStatus @default(DRAFT)

  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  createdById String?  @db.Uuid
  updatedById String?  @db.Uuid

  controls Control[]
  audits   Audit[]

  @@map("templates")
}

/// Nodo del árbol de la plantilla. Evaluable = hoja (sin hijos). Los capítulos de primer nivel tienen parentId NULL.
/// Se carga completo por plantilla y el árbol se arma en memoria.
model Control {
  id          String  @id @default(uuid(7)) @db.Uuid
  templateId  String  @db.Uuid
  parentId    String? @db.Uuid
  /// Numeración de la norma tal como la escribe la plantilla ("A.5.1", "APO01.01", "Art. 5"…). Texto libre, opcional,
  /// NO único y sin lógica sobre él: el orden es `position` y la jerarquía es `parentId`.
  reference   String?
  /// El texto del control. En una hoja ES el criterio que se evalúa.
  title       String
  /// Texto explicativo de la norma, opcional en cualquier nodo.
  description String?
  position    Int

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  template          Template           @relation(fields: [templateId], references: [id], onDelete: Cascade)
  parent            Control?           @relation("ControlTree", fields: [parentId, templateId], references: [id, templateId], onDelete: Cascade)
  children          Control[]          @relation("ControlTree")
  suggestedFindings SuggestedFinding[]
  evaluations       Evaluation[]

  // Destino de la FK compuesta del árbol: el padre debe ser de la misma plantilla.
  @@unique([id, templateId])
  @@index([templateId, parentId, position])
  @@index([parentId])
  @@map("controls")
}

/// Hallazgo redactado de antemano para (control, nivel). Se copia a Evaluation.findings solo si está vacío.
/// Solo existen filas con texto real; la matriz completa se calcula al leer.
model SuggestedFinding {
  id        String @id @default(uuid(7)) @db.Uuid
  controlId String @db.Uuid
  levelId   String @db.Uuid
  text      String

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  control Control    @relation(fields: [controlId], references: [id], onDelete: Cascade)
  level   ScaleLevel @relation(fields: [levelId], references: [id], onDelete: Cascade)

  @@unique([controlId, levelId])
  @@index([levelId])
  @@map("suggested_findings")
}

// ─────────────────────────────────────────────────────────────────────────────
// Auditorías
// ─────────────────────────────────────────────────────────────────────────────

model Audit {
  id   String @id @default(uuid(7)) @db.Uuid
  /// Generado desde la secuencia `audit_code_seq` (ver migración inicial)
  code String @unique
  name String

  /// HTML permitido (se sanea en la entrada)
  introduction String?
  scopeNotes   String?
  objectives   String?

  templateId     String @db.Uuid
  organizationId String @db.Uuid
  scaleId        String @db.Uuid
  managerId      String @db.Uuid

  /// Seguimiento: auditoría cerrada a la que esta da continuidad
  parentAuditId  String? @db.Uuid
  /// 0 = auditoría inicial
  followUpNumber Int     @default(0)

  status AuditStatus @default(DRAFT)

  plannedStart DateTime? @db.Date
  plannedEnd   DateTime? @db.Date
  closedAt     DateTime? @db.Timestamptz(3)

  /// Id de la carpeta en Nextcloud. La ruta se deriva de `code` (storage-paths.ts)
  storageFolderId String?

  /// Bloqueo optimista (se incrementa en cada update desde el adaptador)
  version Int @default(0)

  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  createdById String?  @db.Uuid
  updatedById String?  @db.Uuid

  template     Template     @relation(fields: [templateId], references: [id], onDelete: Restrict)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  scale        Scale        @relation(fields: [scaleId], references: [id], onDelete: Restrict)
  manager      User         @relation("AuditManager", fields: [managerId], references: [id], onDelete: Restrict)
  parentAudit  Audit?       @relation("AuditFollowUp", fields: [parentAuditId], references: [id], onDelete: Restrict)
  followUps    Audit[]      @relation("AuditFollowUp")

  scopeItems  AuditScopeItem[]
  members     AuditMember[]
  evaluations Evaluation[]
  reports     Report[]
  events      AuditEvent[]

  @@unique([parentAuditId, followUpNumber])
  @@index([organizationId, status])
  @@index([templateId])
  @@index([managerId])
  @@index([status, plannedEnd])
  @@map("audits")
}

/// Qué se audita, definido DENTRO de la auditoría en ese momento (un sistema, un proceso, una sede…). Sin elementos =
/// toda la organización. Solo se edita mientras la auditoría está en DRAFT. Un seguimiento hereda una COPIA del
/// alcance de la auditoría que sigue y no puede modificarlo: incluir algo distinto ya no es seguimiento, es otra auditoría.
model AuditScopeItem {
  id      String @id @default(uuid(7)) @db.Uuid
  auditId String @db.Uuid
  name    String

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  audit Audit @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@unique([auditId, name])
  @@map("audit_scope_items")
}

/// Quitar un miembro es un borrado; queda registrado en AuditEvent.
model AuditMember {
  id      String    @id @default(uuid(7)) @db.Uuid
  auditId String    @db.Uuid
  userId  String    @db.Uuid
  role    AuditRole @default(INSPECTOR)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  audit Audit @relation(fields: [auditId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([auditId, userId])
  @@index([userId])
  @@map("audit_members")
}

/// Evaluación de un control (hoja) dentro de una auditoría. El estado vigente vive aquí;
/// el historial de decisiones está en EvaluationReview. (Antes: audit_responses + audit_evaluations.)
model Evaluation {
  id        String @id @default(uuid(7)) @db.Uuid
  auditId   String @db.Uuid
  controlId String @db.Uuid

  /// Opción esperada para ESTE control (varía por control). Obligatoria antes de iniciar la auditoría; nulo solo en DRAFT.
  expectedLevelId     String? @db.Uuid
  /// Por qué se espera esa opción (p. ej. "criticidad alta según el análisis de riesgos"). Opcional.
  expectedLevelReason String?
  assignedUserId      String? @db.Uuid

  status EvaluationStatus @default(NOT_STARTED)
  /// Ronda devolver/corregir, desde 1
  round  Int              @default(1)

  achievedLevelId String? @db.Uuid
  findings        String?
  notes           String?

  isNotApplicable     Boolean @default(false)
  notApplicableReason String?

  /// Bloqueo optimista
  version Int @default(0)

  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  createdById String?  @db.Uuid
  updatedById String?  @db.Uuid

  audit         Audit       @relation(fields: [auditId], references: [id], onDelete: Cascade)
  control       Control     @relation(fields: [controlId], references: [id], onDelete: Restrict)
  expectedLevel ScaleLevel? @relation("EvaluationExpectedLevel", fields: [expectedLevelId], references: [id], onDelete: Restrict)
  achievedLevel ScaleLevel? @relation("EvaluationAchievedLevel", fields: [achievedLevelId], references: [id], onDelete: Restrict)
  assignedUser  User?       @relation(fields: [assignedUserId], references: [id], onDelete: SetNull)

  reviews   EvaluationReview[]
  evidences Evidence[]

  @@unique([auditId, controlId])
  @@index([auditId, status])
  @@index([assignedUserId, status])
  @@index([controlId])
  @@map("evaluations")
}

/// Log append-only de decisiones sobre una evaluación. `snapshot` guarda el contenido en ese momento
/// (nivel, score, hallazgos, notas, N/A, ids de evidencia; tipado con Zod). Restaurar una ronda lee el snapshot.
model EvaluationReview {
  id           String       @id @default(uuid(7)) @db.Uuid
  evaluationId String       @db.Uuid
  round        Int
  action       ReviewAction
  actorId      String       @db.Uuid
  comments     String?
  snapshot     Json

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  evaluation Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  actor      User       @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([evaluationId, createdAt])
  @@index([actorId, createdAt])
  @@map("evaluation_reviews")
}

/// Metadatos de un archivo de evidencia. La fuente de verdad del archivo es Nextcloud (`storageFileId`).
/// Quién la subió = `createdById`. Único modelo con soft-delete: la evidencia eliminada debe seguir siendo trazable.
model Evidence {
  id            String    @id @default(uuid(7)) @db.Uuid
  evaluationId  String    @db.Uuid
  /// Ronda de la evaluación en la que se adjuntó
  round         Int
  title         String
  description   String?
  fileName      String
  mimeType      String
  size          BigInt
  storageFileId String    @unique
  deletedAt     DateTime? @db.Timestamptz(3)

  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  createdById String?  @db.Uuid
  updatedById String?  @db.Uuid

  evaluation Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)

  @@index([evaluationId, round])
  @@map("evidences")
}

/// Informe generado. Solo se guarda si la generación tuvo éxito. Quién lo generó = `createdById`. Nombre y tamaño del
/// archivo no se copian: son de Nextcloud (fuente de verdad) y nadie los leía; el nombre de descarga se deriva del título.
model Report {
  id            String     @id @default(uuid(7)) @db.Uuid
  auditId       String     @db.Uuid
  type          ReportType @default(COMPLIANCE)
  title         String
  storageFileId String     @unique

  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  createdById String?  @db.Uuid
  updatedById String?  @db.Uuid

  audit Audit @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@index([auditId, createdAt])
  @@map("reports")
}

// ─────────────────────────────────────────────────────────────────────────────
// Historial
// ─────────────────────────────────────────────────────────────────────────────

/// Log append-only de cada auditoría. Sin texto: `type` + `payload` (Zod discriminado por `type`, en events.ts
/// de cada módulo). El mensaje se genera al leer (messages.es.ts). `type` y `subjectType` son String a propósito:
/// agregar un evento no debe requerir una migración.
model AuditEvent {
  id           String  @id @default(uuid(7)) @db.Uuid
  auditId      String  @db.Uuid
  type         String
  actorId      String? @db.Uuid
  targetUserId String? @db.Uuid
  subjectType  String
  subjectId    String  @db.Uuid
  payload      Json

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  audit      Audit @relation(fields: [auditId], references: [id], onDelete: Cascade)
  actor      User? @relation("EventActor", fields: [actorId], references: [id], onDelete: Restrict)
  targetUser User? @relation("EventTarget", fields: [targetUserId], references: [id], onDelete: Restrict)

  @@index([auditId, createdAt])
  @@index([subjectType, subjectId])
  @@index([actorId])
  @@index([targetUserId])
  @@map("audit_events")
}
